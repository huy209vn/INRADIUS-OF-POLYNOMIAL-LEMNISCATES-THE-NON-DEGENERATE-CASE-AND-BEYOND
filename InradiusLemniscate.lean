/-
Theorem: The inradius of the lemniscate is bounded below by |B'(0)|/(4n) using the conformal factorization and Koebe theorem.
-/
theorem conformal_factorization_inradius_bound
    (P : Polynomial ℂ) (z_star : ℂ) (n : ℕ)
    (h_deg : P.natDegree = n)
    (h_root : z_star ∈ P.roots)
    (h_deriv_le : ‖(derivative P).eval z_star‖ ≤ n)
    (h_deriv_ne : (derivative P).eval z_star ≠ 0)
    (phi : ℂ → ℂ) (B : ℂ → ℂ)
    (h_diff_phi : DifferentiableOn ℂ phi (Metric.ball 0 1))
    (h_inj_phi : Set.InjOn phi (Metric.ball 0 1))
    (h_phi0 : phi 0 = z_star)
    (h_comp : ∀ w ∈ Metric.ball 0 1, B w = P.eval (phi w))
    (h_B_bound : ∀ w ∈ Metric.ball 0 1, ‖B w‖ < 1)
    (h_deriv_phi0 : deriv phi 0 = deriv B 0 / (derivative P).eval z_star)
    (h_koebe : KoebeQuarterStatement) :
    inradius (lemniscate P 1) ≥ ‖deriv B 0‖ / (4 * n) := by
      -- By the KoebeQuarterStatement, there exists a radius $r$ such that the ball of radius $r$ centered at $\phi(0)$ is contained in $\phi(\text{Metric.ball } 0 1)$.
      have h_ball : ∀ r, 0 < r → r < ‖deriv phi 0‖ / 4 → Metric.ball (phi 0) r ⊆ lemniscate P 1 := by
        intros r hr_pos hr_lt
        have h_ball_subset : Metric.ball (phi 0) r ⊆ phi '' (Metric.ball 0 1) := by
          have := h_koebe phi (phi 0) (deriv phi 0) ?_ ?_ ?_ ?_ ?_ <;> simp_all +decide [ Set.subset_def ];
          · exact fun x hx => this x <| lt_of_lt_of_le hx hr_lt.le;
          · intro h; norm_num [ h ] at hr_lt; linarith;
        generalize_proofs at *; (
        intro w hw; specialize h_ball_subset hw; aesop;)
      generalize_proofs at *; (
      -- Since $|deriv phi 0| = |deriv B 0| / |P'(z_star)|$ and $|P'(z_star)| \leq n$, we have $|deriv phi 0| \geq |deriv B 0| / n$.
      have h_deriv_phi0_bound : ‖deriv phi 0‖ ≥ ‖deriv B 0‖ / n := by
        rw [ h_deriv_phi0, norm_div ] ; gcongr;
      generalize_proofs at *; (
      -- Since the inradius is the supremum of the radii of balls contained in the lemniscate, and we have that for any r < ‖deriv B 0‖ / (4n), the ball of radius r is contained in the lemniscate, it follows that the inradius must be at least ‖deriv B 0‖ / (4n).
      have h_inradius_ge : ∀ r, 0 < r → r < ‖deriv B 0‖ / (4 * n) → r ≤ inradius (lemniscate P 1) := by
        intros r hr hr';
        refine' le_csSup _ _ <;> norm_num
        generalize_proofs at *; (
        -- Since the lemniscate is bounded, there exists some M such that for all z in the lemniscate, ‖z‖ ≤ M.
        obtain ⟨M, hM⟩ : ∃ M, ∀ z ∈ lemniscate P 1, ‖z‖ ≤ M := by
          have h_bounded : ∃ M, ∀ z, ‖P.eval z‖ < 1 → ‖z‖ ≤ M := by
            have h_poly_growth : Filter.Tendsto (fun z : ℂ => ‖P.eval z‖) (Filter.cocompact ℂ) Filter.atTop := by
              apply_rules [ Polynomial.tendsto_norm_atTop ];
              · exact not_le.mp fun h => by rw [ Polynomial.eq_C_of_degree_le_zero h ] at h_root h_deriv_ne; aesop;
              · exact tendsto_norm_cocompact_atTop
            have := h_poly_growth.eventually_gt_atTop 1
            generalize_proofs at *; (
            rw [ Filter.eventually_iff ] at this; simp_all +decide [ Filter.mem_cocompact ] ; (
            obtain ⟨ t, ht₁, ht₂ ⟩ := this; rcases ht₁.isBounded.exists_norm_le with ⟨ M, hM ⟩ ; exact ⟨ M, fun z hz => hM z <| by_contra fun hz' => not_lt_of_ge ( ht₂ ( by simpa using hz' ) |> le_of_lt ) hz ⟩ ;))
          generalize_proofs at *; (
          exact h_bounded.imp fun M hM z hz => hM z hz)
        generalize_proofs at *; (
        use M + M + 1; intro r hr; rcases hr with ⟨ hr₀, z, hz ⟩ ; have := hM z ( hz ( Metric.mem_ball_self hr₀ ) ) ; norm_num at *; (
        have := hM ( z + r / 2 ) ( hz <| Metric.mem_ball.mpr <| by simpa [ abs_of_pos hr₀ ] ) ; ( have := hM ( z - r / 2 ) ( hz <| Metric.mem_ball.mpr <| by simpa [ abs_of_pos hr₀ ] ) ; ( norm_num [ Complex.normSq, Complex.norm_def ] at *; ) );
        rw [ Real.sqrt_le_iff ] at * ; nlinarith [ sq_nonneg ( z.re - r / 2 ), sq_nonneg ( z.re + r / 2 ) ] ;);));
        exact ⟨ hr, phi 0, h_ball r hr ( by ring_nf at *; linarith ) ⟩
      generalize_proofs at *; (
      contrapose! h_inradius_ge;
      by_cases h : 0 < ‖deriv B 0‖ / ( 4 * n ) <;> simp_all +decide [ div_eq_mul_inv ];
      · exact ⟨ ( inradius ( lemniscate P 1 ) + ‖deriv B 0‖ * ( ( n : ℝ ) ⁻¹ * 4⁻¹ ) ) / 2, by linarith [ show 0 ≤ inradius ( lemniscate P 1 ) from by apply_rules [ Real.sSup_nonneg ] ; rintro r ⟨ hr₀, z, hz ⟩ ; exact hr₀.le ], by linarith, by linarith ⟩;
      · exact False.elim <| h.not_lt <| mul_pos ( norm_pos_iff.mpr <| show deriv B 0 ≠ 0 from fun h' => by norm_num [ h' ] at *; linarith [ show 0 ≤ inradius ( lemniscate P 1 ) from by apply_rules [ Real.sSup_nonneg ] ; rintro r ⟨ hr, z, hz ⟩ ; positivity ] ) <| mul_pos ( inv_pos.mpr <| Nat.cast_pos.mpr <| Nat.pos_of_ne_zero <| by aesop_cat ) <| by norm_num;)))
